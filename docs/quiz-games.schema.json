{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz-games.schema.json",
  "title": "Study activity file (quiz or game)",
  "description": "One file = one activity. `kind` selects the item shape. Unknown fields are rejected everywhere.",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "subject", "title", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/slug" },
    "kind": { "enum": ["quiz", "match", "order", "categorize", "truefalse", "flashcards"] },
    "subject": { "$ref": "#/$defs/text" },
    "unit": { "$ref": "#/$defs/text" },
    "title": { "$ref": "#/$defs/text" },
    "description": { "type": "string" },
    "lang": { "type": "string", "default": "he", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "items": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "quiz" } } },       "then": { "properties": { "items": { "items": { "$ref": "#/$defs/quizItem" } } } } },
    { "if": { "properties": { "kind": { "const": "match" } } },      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/matchItem" } } } } },
    { "if": { "properties": { "kind": { "const": "order" } } },      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/orderItem" } } } } },
    { "if": { "properties": { "kind": { "const": "categorize" } } }, "then": { "properties": { "items": { "items": { "$ref": "#/$defs/categorizeItem" } } } } },
    { "if": { "properties": { "kind": { "const": "truefalse" } } },  "then": { "properties": { "items": { "items": { "$ref": "#/$defs/trueFalseItem" } } } } },
    { "if": { "properties": { "kind": { "const": "flashcards" } } }, "then": { "properties": { "items": { "items": { "$ref": "#/$defs/flashcardItem" } } } } }
  ],
  "$defs": {
    "slug": {
      "description": "Lowercase letters, digits, single hyphens. Must equal the file name without .json.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "pattern": "\\S" },
    "itemId": {
      "description": "Unique within the file. Stable forever: saved progress is keyed by it. Never reuse a deleted id.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*[0-9]+$"
    },
    "quizItem": {
      "type": "object",
      "required": ["id", "topic", "question", "options", "correct", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "topic": { "$ref": "#/$defs/text" },
        "question": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "note": { "type": "string", "description": "Shown when this option is chosen: the misconception behind it." }
            }
          }
        },
        "correct": { "type": "integer", "minimum": 0, "maximum": 3, "description": "Index into options as written. The engine shuffles." },
        "explanation": { "$ref": "#/$defs/text" }
      }
    },
    "matchItem": {
      "description": "A set of 4-8 pairs shown as two columns; the right column is shuffled.",
      "type": "object",
      "required": ["id", "topic", "pairs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "topic": { "$ref": "#/$defs/text" },
        "prompt": { "type": "string", "description": "Instruction line, e.g. 'התאימו כל הורמון לאיבר המפריש'." },
        "pairs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["left", "right"],
            "additionalProperties": false,
            "properties": {
              "left": { "$ref": "#/$defs/text" },
              "right": { "$ref": "#/$defs/text" },
              "explanation": { "type": "string" }
            }
          }
        }
      }
    },
    "orderItem": {
      "description": "A sequence to put in order (a pathway, a procedure). `steps` is written in the CORRECT order; the engine shuffles.",
      "type": "object",
      "required": ["id", "topic", "prompt", "steps", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "topic": { "$ref": "#/$defs/text" },
        "prompt": { "$ref": "#/$defs/text" },
        "steps": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "$ref": "#/$defs/text" } },
        "explanation": { "$ref": "#/$defs/text" }
      }
    },
    "categorizeItem": {
      "description": "Sort entries into 2-4 categories. `category` is an index into `categories`.",
      "type": "object",
      "required": ["id", "topic", "prompt", "categories", "entries", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "topic": { "$ref": "#/$defs/text" },
        "prompt": { "$ref": "#/$defs/text" },
        "categories": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/text" } },
        "entries": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["text", "category"],
            "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "category": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
          }
        },
        "explanation": { "$ref": "#/$defs/text" }
      }
    },
    "trueFalseItem": {
      "type": "object",
      "required": ["id", "topic", "statement", "correct", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "topic": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "correct": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/text" }
      }
    },
    "flashcardItem": {
      "type": "object",
      "required": ["id", "topic", "front", "back"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "topic": { "$ref": "#/$defs/text" },
        "front": { "$ref": "#/$defs/text" },
        "back": { "$ref": "#/$defs/text" },
        "hint": { "type": "string" }
      }
    }
  }
}
